{
  "manifest_version": 3,
  "name": "AiNKI",
  "version": "0.1.0",
  "description": "Turn selected text and images on any page into AiNKI flashcards.",
  "browser_specific_settings": {
    "gecko": {
      "id": "add-cards@ainki",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
